# Banco de Dados PostgreSQL (Multi-Tenant + RLS)
POSTGRES_USER=mm_admin
POSTGRES_PASSWORD=mm_secret_2026
POSTGRES_DB=mm_saas_ebt
DATABASE_URL=postgresql+psycopg2://mm_admin:mm_secret_2026@db:5432/mm_saas_ebt

# Segredos Criptográficos (JWT HS256 e Assinatura de URLs PDF)
MM_JWT_SECRET=mm-saas-jwt-secret-key-production-2026-hmac-sha256
MM_PDF_SIGNING_SECRET=mm-saas-pdf-hmac-secret-2026

# Provedores OAuth2 / OIDC (Google Workspace & GitHub Enterprise)
# Caso vazios em desenvolvimento, o Provedor OAuth2 Sandbox permite testar todos os 6 perfis RBAC instantaneamente.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback

OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:3000/oauth/callback

# IA Governada (Google Gemini 3.8)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8
